---
// Hero component with animated workflow diagram - Czech version
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-50 to-primary-100 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-center">
      <div class="lg:col-span-6">
        <h1 class="text-4xl font-heading font-bold tracking-tight text-gray-900 sm:text-6xl">
          Nasaďte Kubernetes
          <span class="text-primary-600">Infrastrukturu</span>
          za Minuty
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 max-w-2xl">
          Spravujeme a udržujeme vaši Kubernetes infrastrukturu, CI/CD a monitoring stack, 
          takže se můžete soustředit na vývoj vašeho produktu. Kompletní řízená DevOps platforma 
          s automatizovanými deployenty a komplexní observabilitou.
        </p>
        
        <!-- CTA Buttons -->
        <div class="mt-10 flex items-center gap-x-6">
          <a
            href="#demo"
            class="rounded-md bg-primary-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 transition-all duration-200"
          >
            Vyzkoušet Demo
          </a>
          <a 
            href="/cs/docs/quick-start/"
            class="text-base font-semibold leading-6 text-gray-900 hover:text-primary-600 transition-colors duration-200"
          >
            Začít <span aria-hidden="true">→</span>
          </a>
        </div>
        
        <!-- Social Proof -->
        <div class="mt-10 flex items-center gap-x-6">
          <a 
            href="https://github.com/flexydox"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-x-2 text-sm text-gray-600 hover:text-gray-900 transition-colors"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>Prozkoumat na GitHubu</span>
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </a>
          <span class="text-sm text-gray-500">•</span>
          <span class="text-sm text-gray-600">Open Source & MIT licence</span>
        </div>
      </div>
      
      <!-- Animated Workflow Diagram -->
      <div class="mt-16 lg:mt-0 lg:col-span-6">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <div class="workflow-diagram bg-white rounded-2xl shadow-xl p-8 relative overflow-hidden">
            <!-- Background Pattern -->
            <div class="absolute inset-0 bg-gradient-to-br from-primary-50/30 to-transparent"></div>
            
            <!-- Workflow Steps -->
            <div class="relative space-y-6">
              <div class="workflow-step flex items-center space-x-4" data-step="1">
                <div class="flex-shrink-0 w-12 h-12 bg-primary-600 rounded-full flex items-center justify-center">
                  <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-sm font-semibold text-gray-900">make demo</h4>
                  <p class="text-xs text-gray-500">Jeden příkaz na instalaci</p>
                </div>
              </div>
              
              <div class="workflow-arrow">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-gray-400 mx-auto">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </div>
              
              <div class="workflow-step flex items-center space-x-4" data-step="2">
                <div class="flex-shrink-0 w-12 h-12 bg-secondary-600 rounded-full flex items-center justify-center">
                  <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-sm font-semibold text-gray-900">Kind Cluster</h4>
                  <p class="text-xs text-gray-500">Kubernetes prostředí</p>
                </div>
              </div>
              
              <div class="workflow-arrow">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-gray-400 mx-auto">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </div>
              
              <div class="workflow-step flex items-center space-x-4" data-step="3">
                <div class="flex-shrink-0 w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center">
                  <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-sm font-semibold text-gray-900">Grafana Stack</h4>
                  <p class="text-xs text-gray-500">Monitoring & observabilita</p>
                </div>
              </div>
              
              <div class="workflow-arrow">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-gray-400 mx-auto">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </div>
              
              <div class="workflow-step flex items-center space-x-4" data-step="4">
                <div class="flex-shrink-0 w-12 h-12 bg-green-600 rounded-full flex items-center justify-center">
                  <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-sm font-semibold text-gray-900">CI/CD Připraveno</h4>
                  <p class="text-xs text-gray-500">GitHub Actions runners</p>
                </div>
              </div>
            </div>
            
            <!-- Floating Elements -->
            <div class="absolute top-4 right-4 w-2 h-2 bg-primary-400 rounded-full animate-pulse"></div>
            <div class="absolute bottom-8 left-4 w-1 h-1 bg-secondary-400 rounded-full animate-ping"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Background Decoration -->
  <div class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]">
    <div class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-primary-300 to-secondary-300 opacity-30 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]"></div>
  </div>
</section>

<style>
  .workflow-step {
    animation: fadeInUp 0.6s ease-out;
    animation-fill-mode: both;
  }
  
  .workflow-step[data-step="2"] {
    animation-delay: 0.2s;
  }
  
  .workflow-step[data-step="3"] {
    animation-delay: 0.4s;
  }
  
  .workflow-step[data-step="4"] {
    animation-delay: 0.6s;
  }
  
  .workflow-arrow {
    animation: fadeIn 0.4s ease-out 0.8s;
    animation-fill-mode: both;
    opacity: 0;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>