---
// Feature highlights showcasing the toolkit's capabilities
---

<section id="features" class="py-24 sm:py-32 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-heading font-bold tracking-tight text-gray-900 sm:text-4xl">
        Everything You Need for Modern DevOps
      </h2>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        Comprehensive managed platform that eliminates the complexity of setting up and managing 
        Kubernetes-based infrastructure, so you can focus on what matters most - your product.
      </p>
    </div>
    
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
        <!-- Kubernetes Environments -->
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-primary-600">
              <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            Kubernetes Environments
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">
              Fully managed Kubernetes environments on any cloud provider. 
              We handle setup, security, scaling, and maintenance - you deploy your applications.
            </p>
            <p class="mt-6">
              <a href="/docs/kubernetes/" class="text-sm font-semibold leading-6 text-primary-600 hover:text-primary-500">
                Learn more <span aria-hidden="true">→</span>
              </a>
            </p>
          </dd>
        </div>
        
        <!-- Grafana Stack -->
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-orange-500">
              <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            Grafana Stack Monitoring
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">
              Complete observability platform managed for you. Grafana, Prometheus, Loki, and Tempo 
              with pre-configured dashboards, alerting, and incident management.
            </p>
            <p class="mt-6">
              <a href="/docs/grafana/" class="text-sm font-semibold leading-6 text-orange-600 hover:text-orange-500">
                Learn more <span aria-hidden="true">→</span>
              </a>
            </p>
          </dd>
        </div>
        
        <!-- GitHub Runners -->
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-gray-800">
              <svg width="24" height="24" fill="white" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            Self-Hosted GitHub Runners
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">
              Managed CI/CD pipeline with self-hosted GitHub runners in your Kubernetes cluster. 
              Secure, scalable builds and deployments without managing infrastructure.
            </p>
            <p class="mt-6">
              <a href="/docs/cicd/" class="text-sm font-semibold leading-6 text-gray-800 hover:text-gray-600">
                Learn more <span aria-hidden="true">→</span>
              </a>
            </p>
          </dd>
        </div>
        
        <!-- Flexydox API Documentation -->
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-blue-600">
              <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            Flexydox API Documentation
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">
              Create unified documentation for multiple API services effortlessly. Combines OpenAPI 
              and GraphQL specifications with custom markdown using a simple YAML config.
            </p>
            <p class="mt-6">
              <a href="https://github.com/flexydox/flexydox" class="text-sm font-semibold leading-6 text-blue-600 hover:text-blue-500">
                Visit flexydox/flexydox <span aria-hidden="true">→</span>
              </a>
            </p>
          </dd>
        </div>
        
        <!-- DevOps Agent & GitHub Actions -->
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-green-600">
              <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
            </div>
            Flexydox DevOps & Automation
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">
              Automated workflow management with Jira, GitHub, and versioning. 
              We handle the DevOps complexity so your team can focus on feature delivery.
            </p>
            <p class="mt-6">
              <a href="https://github.com/flexydox/fxdx-devops-agent" class="text-sm font-semibold leading-6 text-green-600 hover:text-green-500">
                Visit fxdx-devops-agent <span aria-hidden="true">→</span>
              </a>
            </p>
          </dd>
        </div>
        
        <!-- Infrastructure as Code -->
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-purple-600">
              <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            Infrastructure as Code
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">
              Infrastructure as Code managed and maintained for you. 
              Version-controlled, reproducible environments without the operational overhead.
            </p>
            <p class="mt-6">
              <a href="/docs/infrastructure/" class="text-sm font-semibold leading-6 text-purple-600 hover:text-purple-500">
                Learn more <span aria-hidden="true">→</span>
              </a>
            </p>
          </dd>
        </div>
      </dl>
    </div>
    
    <!-- Flexydox Ecosystem Section -->
    <div class="mx-auto mt-24 max-w-7xl">
      <div class="mx-auto max-w-2xl text-center">
        <h3 class="text-2xl font-heading font-bold tracking-tight text-gray-900 sm:text-3xl">
          Complete Flexydox Ecosystem
        </h3>
        <p class="mt-6 text-lg leading-8 text-gray-600">
          Our full suite of open-source tools that power the managed platform.
        </p>
      </div>
      
      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3">
        <!-- Main Flexydox Tool -->
        <div class="flex flex-col rounded-2xl bg-gray-50 p-8">
          <div class="flex items-center gap-x-4">
            <div class="h-12 w-12 flex items-center justify-center rounded-lg bg-blue-600">
              <svg width="28" height="28" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-lg font-semibold text-gray-900">Flexydox</h4>
              <p class="text-sm text-gray-600">API Documentation Generator</p>
            </div>
          </div>
          <p class="mt-4 text-gray-600">
            Create unified documentation for your API services effortlessly by combining OpenAPI and GraphQL specifications with custom markdown.
          </p>
          <div class="mt-6 flex gap-x-4">
            <a href="https://github.com/flexydox/flexydox" class="text-sm font-semibold text-blue-600 hover:text-blue-500">
              GitHub <span aria-hidden="true">→</span>
            </a>
            <a href="http://examples.flexydox.org/chess" class="text-sm font-semibold text-blue-600 hover:text-blue-500">
              Live Demo <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        
        <!-- DevOps Agent -->
        <div class="flex flex-col rounded-2xl bg-gray-50 p-8">
          <div class="flex items-center gap-x-4">
            <div class="h-12 w-12 flex items-center justify-center rounded-lg bg-green-600">
              <svg width="28" height="28" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
              </svg>
            </div>
            <div>
              <h4 class="text-lg font-semibold text-gray-900">Flexydox DevOps</h4>
              <p class="text-sm text-gray-600">GitHub Actions Automation</p>
            </div>
          </div>
          <p class="mt-4 text-gray-600">
            Powerful GitHub Action for automating development workflows with Jira, GitHub, versioning, and Slack notifications.
          </p>
          <div class="mt-6 flex gap-x-4">
            <a href="https://github.com/flexydox/fxdx-devops-agent" class="text-sm font-semibold text-green-600 hover:text-green-500">
              GitHub <span aria-hidden="true">→</span>
            </a>
            <a href="https://github.com/marketplace/actions/devops-agent" class="text-sm font-semibold text-green-600 hover:text-green-500">
              Marketplace <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        
        <!-- GitHub Actions Suite -->
        <div class="flex flex-col rounded-2xl bg-gray-50 p-8">
          <div class="flex items-center gap-x-4">
            <div class="h-12 w-12 flex items-center justify-center rounded-lg bg-gray-800">
              <svg width="28" height="28" fill="white" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-lg font-semibold text-gray-900">GitHub Actions Suite</h4>
              <p class="text-sm text-gray-600">CI/CD Building Blocks</p>
            </div>
          </div>
          <p class="mt-4 text-gray-600">
            Specialized GitHub Actions for diff reviews, PR commenting, and workflow automation that power modern development processes.
          </p>
          <div class="mt-6 flex gap-x-4">
            <a href="https://github.com/flexydox" class="text-sm font-semibold text-gray-800 hover:text-gray-600">
              All Actions <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>